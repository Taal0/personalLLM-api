# Ollama sunucusu (Aşama 2: PC'deki GPU)
OLLAMA_HOST=http://192.168.1.100:11434

# API sunucusu
API_HOST=0.0.0.0
API_PORT=8000

# CLI istemcisi (varsayılan: yerel API)
API_URL=http://localhost:8000

# Model (Aşama 2a madde 2+)
OLLAMA_MODEL=qwen3:8b-q4_K_M
OLLAMA_TEMPERATURE=0.5

# Persona dosyaları (varsayılan: proje kökünde)
# PERSONA_BASE_PATH=./persona_base.txt
# PERSONA_SURVEY_PATH=./persona_survey.yaml

# Oturum geçmişi (RAM)
MAX_HISTORY_TURNS=10
SESSION_IDLE_TTL_SECONDS=3600
